# Copy to .env.local and fill in. Never commit .env.local.
# Firebase console > Project settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase AI Logic cloud backend: "gemini-developer" (Spark plan, free tier or AI Studio credits)
# or "agent-platform" (Agent Platform / Vertex AI Gemini API, billed to the Blaze plan).
NEXT_PUBLIC_AI_BACKEND=gemini-developer

# App Check (required by Firebase AI Logic). Production builds need one of these site keys.
# Preferred: reCAPTCHA Enterprise key registered in Firebase console > App Check (see README).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Alternative: classic reCAPTCHA v3 site key.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# Local development only. Set to "true" to print a debug token in the console,
# then register it in Firebase console > App Check > Apps > Manage debug tokens.
# Leave empty in production builds.
NEXT_PUBLIC_APPCHECK_DEBUG=true
# Optional: a fixed debug token (UUID) shared by all your local browsers. Used by `npm run dev` only,
# never included in production builds. Register it once with:
#   firebase appcheck:debugtokens:create <token> --app <web-app-id>
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
